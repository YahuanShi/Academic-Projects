# =========================
# ---- Project-specific ignores ----
# =========================

# ---- Dataset and raw data (prevent uploading large files) ----
**/data/**/MNIST/**
**/data/**/FashionMNIST/**
**/data/**/raw/**

# ---- Model weights / large binary files ----
*.pt
*.pth
*.ckpt
*.torch

# ---- Motion-Planning / Robotics build artifacts ----
**/build/
**/CMakeFiles/
**/CMakeCache.txt
**/cmake_install.cmake
**/CMakeOutput.log
**/CMakeTmp/
**/Makefile
**/*.o
**/*.a
**/*.out

# ---- Python cache redundancy (safety net) ----
**/__pycache__/
**/*.cpython-*.pyc

# ---- Top-level projects to ignore ----
Robot-Learning/
Industrial-Robotics/

# =========================
# ---- Keep list (reverse rules) ----
# =========================
!**/requirements.txt
!**/environment.yml
!**/README.md
